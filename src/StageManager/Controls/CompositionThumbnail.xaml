<UserControl
    x:Class="StageManager.Controls.CompositionThumbnail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:StageManager.Controls"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <Grid>
        <Border Background="#40244B" CornerRadius="8" BorderBrush="#80588A" BorderThickness="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8">
                <Image Source="{Binding Icon}" Width="30" Height="30" Margin="0,0,0,5" />
                <TextBlock Text="{Binding Title}" Foreground="#F4EAF6" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="点击恢复窗口" Foreground="#CAB2D1" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="20" />
            </Border.Effect>
        </Border>
        <!-- HostContainer is a sibling of Border (not a child) so it can grow
             past the WPF layout slot via SizeChanged code-behind, giving the
             composition HWND headroom for hover-scale without chopping the
             rounded clip at the HWND boundary. -->
        <Grid x:Name="HostContainer"
              Background="#01000000"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
    </Grid>
</UserControl>
