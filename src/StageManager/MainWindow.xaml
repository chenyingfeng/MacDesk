<Window
    x:Class="StageManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:StageManager"
    xmlns:controls="clr-namespace:StageManager.Controls"
    xmlns:conv="clr-namespace:StageManager.Converters"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    mc:Ignorable="d"
    AllowsTransparency="True"
    ShowInTaskbar="False"
    Topmost="False"
    WindowStyle="None"
    Title="台前调度 C · 便携改进版"
    Height="450"
    Width="240"
    ShowActivated="False"
    Background="Transparent"
    Name="thisWindow">
    <Window.Resources>
        <Style
            x:Key="SceneOpacity"
            TargetType="{x:Type Grid}">
            <!-- Origin 0,0.5: the tray aligns every tile on a shared left edge, so the
                 pop has to grow rightward and downward-from-centre only. A centred
                 origin pushed the left edge out by (scale-1)*width/2 and a hovered
                 tile visibly broke the column. CompositionThumbnail.ComposeTransform
                 mirrors this anchor for the HwndHost surface. -->
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                    To="1.08" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                    To="1.08" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                    To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                    To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="0.96" Duration="0:0:0.08">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="0.96" Duration="0:0:0.08">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonUp">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1.08" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1.08" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <conv:IndexToOffsetMarginConverter x:Key="IndexToOffsetMarginConverter" />
        <conv:IndexToZIndexConverter x:Key="IndexToZIndexConverter" />
    </Window.Resources>
    <Grid>
        <ScrollViewer x:Name="scenesScroll" VerticalScrollBarVisibility="Hidden"
            Background="#01000000"
            HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly"
            PreviewMouseWheel="Sidebar_ScrollWheel" ScrollChanged="Sidebar_ScrollChanged"
            Margin="0,12,0,12" ClipToBounds="True" Focusable="True">
        <ItemsControl
            Name="scenesControl"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Padding="0, 8, 22, 8"
            ItemsSource="{Binding Scenes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,28" Background="#01000000"
                        Visibility="{Binding Visibility}"
                        Style="{StaticResource SceneOpacity}">
                        <Grid.ToolTip><ToolTip Content="{Binding Title}" /></Grid.ToolTip>

                        <!-- Windows -->
                        <ItemsControl
                            ItemsSource="{Binding Windows}"
                            AlternationCount="1000">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid
                                        Margin="0,0,0,0"></Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- HorizontalAlignment=Left is load-bearing: the panel is a
                                         Grid and these tiles carry an explicit Width, so the WPF
                                         default (Stretch) CENTRES each one in the row. Scenes whose
                                         windows differ in width then get different left edges, and
                                         within a scene the first window no longer lines up with the
                                         other apps. Left pins every tile's left edge to the row
                                         origin; the deliberate 10px-per-index cascade below (see
                                         IndexToOffsetMarginConverter) then offsets from there, so
                                         index 0 sits flush left. -->
                                    <controls:CompositionThumbnail
                                        PreviewHandle="{Binding Handle}"
                                        CornerRadius="8"
                                        HorizontalAlignment="Left"
                                        TopEdgeDegrees="{Binding DataContext.TiltTopDegrees, RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}"
                                        BottomEdgeDegrees="{Binding DataContext.TiltBottomDegrees, RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}"
                                        Width="{Binding PreviewWidth}"
                                        Height="{Binding PreviewHeight}"
                                        MirrorScale="{Binding RenderTransform.(ScaleTransform.ScaleX), RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}"
                                        MirrorOpacity="{Binding Opacity, RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}"
                                        Margin="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource IndexToOffsetMarginConverter}}"
                                        Panel.ZIndex="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource IndexToZIndexConverter}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
        <tb:TaskbarIcon
            x:Name="trayIcon"
            Visibility="Visible"
            ToolTipText="台前调度 · Ctrl+Alt+Shift+F12 退出并恢复窗口"
            IconSource="StageManager.ico"
            MenuActivation="LeftOrRightClick"
            NoLeftClickDelay="True">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource TrayContextMenuStyle}" Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                    <MenuItem Style="{StaticResource TrayMenuLabelStyle}" Header="{Binding AppHeaderText}" />
                    <Separator Style="{StaticResource TrayMenuSeparatorStyle}" />
                    <MenuItem Style="{StaticResource TrayMenuItemStyle}" Header="显示 / 隐藏任务栏与托盘" Click="MenuItem_TaskbarToggle_Click" />
                    <MenuItem Style="{StaticResource TrayMenuItemStyle}" Header="显示桌面 / 返回任务" Click="MenuItem_Desktop_Click" />
                    <MenuItem Style="{StaticResource TrayMenuItemStyle}" Header="收回全部台前窗口" Click="Sidebar_Stow_Click" />
                    <MenuItem Style="{StaticResource TrayMenuItemStyle}" Header="收起侧栏" Click="Sidebar_Hide_Click" />
                    <Separator Style="{StaticResource TrayMenuSeparatorStyle}" />
                    <MenuItem Style="{StaticResource TrayMenuItemStyle}" Header="使用说明" Click="MenuItem_Help_Click" />
                    <MenuItem Style="{StaticResource TrayMenuItemStyle}" Header="上游项目与许可" Click="MenuItem_ProjectPage_Click" />
                    <MenuItem Style="{StaticResource TrayMenuItemStyle}" Header="退出并恢复全部窗口" Click="MenuItem_Quit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
